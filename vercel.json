{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {"api/text-drop.js": {"maxDuration": 60}},
  "headers": [
    {
      "source": "/text-drop.html",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Robots-Tag", "value": "noindex, nofollow"},
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self' https://blob.vercel-storage.com https://*.blob.vercel-storage.com; form-action 'self'; base-uri 'none'; frame-ancestors 'none'"}
      ]
    }
  ]
}
